{% layout none %}
{%- comment -%}
  Gift card (shown from the gift card email). A pink panel with the balance,
  the code with copy, print and a shop button. Gift cards are off for now;
  confirm with Rich before enabling gift card products.
{%- endcomment -%}
{%- liquid
  assign formatted_code = gift_card.code | format_code
  assign shop_url = collections.pies.url | default: routes.all_products_collection_url
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {{ 'Futura-CondensedExtraBold.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'Futura-Medium.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {% render 'font-faces' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <header class="gift-card__header page-width">
      <a class="gift-card__wordmark type-d4" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
    </header>
    <main id="MainContent" class="gift-card page-width">
      <div class="gift-card__panel">
        <div class="gift-card__top">
          <h1 class="gift-card__title type-d4">{{ 'gift_card.title' | t }}</h1>
          <button type="button" class="button button--outline gift-card__print" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
        </div>
        <p class="gift-card__balance type-d2">{{ gift_card.balance | money_without_trailing_zeros }}</p>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="gift-card__note type-body">{{ 'gift_card.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%-d %B %Y' -%}
          <p class="gift-card__note type-meta">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {%- endif -%}
        <div class="gift-card__code-row">
          <p class="gift-card__code type-body-l" aria-label="{{ 'gift_card.code_label' | t | escape }}">{{ formatted_code }}</p>
          <button type="button" class="button button--outline gift-card__copy" data-code="{{ gift_card.code | escape }}">{{ 'gift_card.copy' | t }}</button>
        </div>
        <a class="button" href="{{ shop_url }}">{{ 'gift_card.shop' | t }}</a>
        <p class="visually-hidden" role="status" data-copy-status></p>
      </div>
    </main>
    <script>
      document.querySelector('.gift-card__copy').addEventListener('click', (event) => {
        navigator.clipboard && navigator.clipboard.writeText(event.currentTarget.dataset.code).then(() => {
          document.querySelector('[data-copy-status]').textContent = {{ 'gift_card.copied' | t | json }};
        });
      });
    </script>
  </body>
</html>
