{% doc %}
  Self-hosted brand fonts. Both files live in assets/ and are preloaded in
  layout/theme.liquid. Futura-Medium.woff2 is still to be uploaded; the
  licence is held.
{% enddoc %}
{% style %}
  @font-face {
    font-family: 'Futura Condensed ExtraBold';
    src: url('{{ 'Futura-CondensedExtraBold.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Futura Medium';
    src: url('{{ 'Futura-Medium.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
{% endstyle %}
