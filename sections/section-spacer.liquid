{%- comment -%}
  Section spacer (a white block): display title on the top line, copy beside
  it, optional button 24 under the copy. Block padding and the rule between
  white blocks come from the block system (assets/sections.css).
{%- endcomment -%}
<section class="spacer page-width">
  {% render 'block-head',
    title: section.settings.title,
    copy: section.settings.copy,
    prompt: section.settings.prompt,
    button_label: section.settings.button_label,
    button_link: section.settings.button_link,
    button_style: section.settings.button_style,
    button_mobile: section.settings.button_mobile
  %}
</section>

{% schema %}
{
  "name": "Section spacer",
  "class": "section-spacer block block--white",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Title" },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Short paragraph.</p>" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "prompt", "label": "Lead-in line", "info": "Optional, e.g. Not sure what to get?" },
    { "type": "text", "id": "button_label", "label": "Label" },
    { "type": "url", "id": "button_link", "label": "Link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    { "type": "checkbox", "id": "button_mobile", "label": "Show button on mobile", "default": true }
  ],
  "presets": [{ "name": "Section spacer" }]
}
{% endschema %}
