{%- comment -%}
  Password page, opening soon: a colour split. Colour side: title on the top
  line, copy, sign up (Shopify customer form) at the foot. Photo side, with a
  "password" button top right that opens the store password form.
{%- endcomment -%}
{%- liquid
  assign email_label = 'footer.email' | t
  assign password_label = 'password.password' | t
  assign close_label = 'password.close' | t
-%}
<section class="password-split" style="--split-colour: var(--colour-{{ section.settings.colour }});">
  <div class="password-split__text">
    <h1 class="password-split__title type-d2">{{ section.settings.title | escape }}</h1>
    <div class="password-split__bottom">
      {%- if section.settings.copy != blank -%}
        <div class="password-split__copy">{{ section.settings.copy }}</div>
      {%- endif -%}
      {%- form 'customer', id: 'PasswordSignUp', class: 'password-split__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,opening">
        {% render 'field', id: 'PasswordSignUpEmail', name: 'contact[email]', type: 'email', label: email_label, autocomplete: 'email', required: true %}
        {% render 'button', label: section.settings.button_label, type: 'submit' %}
        {%- if form.posted_successfully? -%}
          <p class="type-meta" role="status">{{ 'footer.sign_up_success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="type-meta" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
  <div class="password-split__image">
    {% render 'media',
      image: section.settings.image,
      preview: section.settings.preview_image,
      ratio: '4 / 5',
      sizes: '(min-width: 750px) 50vw, 100vw',
      colour: 'clementine',
      priority: true,
      class: 'password-split__media'
    %}
    <button type="button" class="button button--outline password-split__open" data-password-open aria-haspopup="dialog">{{ password_label }}</button>
  </div>
</section>

<dialog class="password-panel" aria-labelledby="PasswordPanelTitle" data-password-panel>
  <div class="password-panel__top">
    <h2 class="password-panel__title type-d4" id="PasswordPanelTitle">{{ 'password.password_label' | t }}</h2>
    <button type="button" class="button button--outline" data-password-close>{{ close_label }}</button>
  </div>
  {%- form 'storefront_password', class: 'password-panel__form' -%}
    {%- if form.errors -%}
      <p class="type-meta" role="alert" data-open-on-load>{{ form.errors | default_errors }}</p>
    {%- endif -%}
    {% render 'field', id: 'PasswordInput', name: 'password', type: 'password', label: password_label, autocomplete: 'current-password', required: true %}
    {%- assign enter_label = 'password.enter' | t -%}
    {% render 'button', label: enter_label, type: 'submit' %}
  {%- endform -%}
</dialog>

<script>
  (() => {
    const panel = document.querySelector('[data-password-panel]');
    if (!panel || !panel.showModal) return;
    const open = () => { panel.showModal(); panel.querySelector('input[type=password]').focus(); };
    document.querySelector('[data-password-open]').addEventListener('click', open);
    panel.querySelector('[data-password-close]').addEventListener('click', () => panel.close());
    panel.addEventListener('click', (e) => { if (e.target === panel) panel.close(); });
    if (panel.querySelector('[data-open-on-load]')) open();
  })();
</script>

{% schema %}
{
  "name": "Opening soon",
  "class": "section-password-main block block--colour",
  "settings": [
    {
      "type": "select",
      "id": "colour",
      "label": "Colour",
      "options": [
        { "value": "birthday-pink", "label": "Birthday pink" },
        { "value": "clementine", "label": "Clementine" },
        { "value": "blue-sky", "label": "Blue sky" },
        { "value": "strawberry", "label": "Strawberry" }
      ],
      "default": "birthday-pink"
    },
    { "type": "text", "id": "title", "label": "Title", "default": "Opening soon" },
    { "type": "richtext", "id": "copy", "label": "Copy" },
    { "type": "text", "id": "button_label", "label": "Sign up button", "default": "sign up" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "preview_image", "label": "Temporary preview image", "info": "Theme asset from Figma, shown until an image is chosen. Clear before launch." }
  ]
}
{% endschema %}
