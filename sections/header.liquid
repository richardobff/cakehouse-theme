{%- comment -%}
  Site header.
  - Desktop home (masthead): wordmark across 8 columns; right column with the
    cart, the open/closed status line and the address; nav row below.
  - Desktop other pages (compact): small wordmark left, nav and cart right.
  - Mobile, every page: wordmark, status line, address, nav with cart.
  A compact bar slides in on desktop once the header scrolls away.
  Opening hours live in Theme settings › Opening hours; assets/header.js
  works out the status line in Australia/Sydney time every minute.
{%- endcomment -%}
{%- liquid
  assign variant = section.settings.variant
  if variant == 'auto'
    if template.name == 'index'
      assign variant = 'masthead'
    else
      assign variant = 'compact'
    endif
  endif

  assign order_url = section.settings.order_url | default: routes.all_products_collection_url

  assign cart_count = cart.item_count
  if settings.pickup_product != blank
    for item in cart.items
      if item.product_id == settings.pickup_product.id
        assign cart_count = cart_count | minus: item.quantity
      endif
    endfor
  endif

  assign address_lines = section.settings.address | newline_to_br | split: '<br />'

  # Directions: the setting, or Google Maps directions to the pick up address.
  assign maps_destination = settings.pickup_address | default: 'Fitzroy VIC' | url_param_escape
  assign directions_url = section.settings.directions_url | default: 'https://www.google.com/maps/dir/?api=1&destination=' | append: maps_destination
-%}

{%- comment -%}
  Each page has a colour for its underline: order clementine, menu pink,
  visit blue, about strawberry. "order" has no page of its own; it shows its
  underline on product pages and while the order panel is open.
{%- endcomment -%}
{%- capture nav_links -%}
  <a class="header__link{% if request.page_type == 'product' %} is-active{% endif %}" href="{{ order_url }}" style="--nav-colour: var(--colour-clementine);" data-order-trigger aria-haspopup="dialog" aria-expanded="false">
    {{- 'header.order' | t -}}
  </a>
  {%- for link in section.settings.menu.links -%}
    {%- liquid
      assign link_handle = link.url | split: '/' | last | split: '?' | first
      case link_handle
        when 'menu'
          assign nav_colour = 'birthday-pink'
        when 'visit'
          assign nav_colour = 'blue-sky'
        when 'about'
          assign nav_colour = 'strawberry'
        else
          assign nav_colour = 'clementine'
      endcase
      assign link_current = link.current
      if link.url == request.path
        assign link_current = true
      endif
    -%}
    <a class="header__link" href="{{ link.url }}" style="--nav-colour: var(--colour-{{ nav_colour }});" {% if link_current %}aria-current="page"{% endif %}>
      {{- link.title | downcase -}}
    </a>
  {%- endfor -%}
{%- endcapture -%}

{%- capture cart_button -%}
  <a class="cart-button" href="{{ routes.cart_url }}" data-cart-trigger>
    {{ 'icon-cart.svg' | inline_asset_content }}
    <span class="visually-hidden">{{ 'header.cart' | t }}</span>
    <span class="cart-button__count" data-cart-count>{{ cart_count }}</span>
  </a>
{%- endcapture -%}

<header class="header header--{{ variant }}" data-header>
  <a class="visually-hidden skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  <a class="header__wordmark" href="{{ routes.root_url }}">
    {%- comment -%} On home the wordmark is the page's h1; it looks the same. {%- endcomment -%}
    {%- if template.name == 'index' -%}
      <h1 class="header__wordmark-heading">
        <span class="visually-hidden">{{ shop.name }}</span>
        {{ 'logo-wordmark.svg' | inline_asset_content }}
      </h1>
    {%- else -%}
      <span class="visually-hidden">{{ shop.name }}</span>
      {{ 'logo-wordmark.svg' | inline_asset_content }}
    {%- endif -%}
  </a>

  <div class="header__info">
    <div class="header__info-cart">{{ cart_button }}</div>
    <div class="header__details">
      <p class="header__detail header__status" data-open-status hidden>
        <span class="header__marker" aria-hidden="true"><span class="header__dot"></span></span>
        <span class="header__detail-text" data-open-status-text></span>
      </p>
      {%- if section.settings.address != blank -%}
        <a class="header__detail header__address" href="{{ directions_url }}" target="_blank" rel="noopener">
          <span class="header__marker" aria-hidden="true">{{ 'icon-pin.svg' | inline_asset_content }}</span>
          <span class="header__detail-text">
            {%- for line in address_lines -%}
              <span class="header__address-line">{{ line | strip | escape }}</span>
            {%- endfor -%}
            <span class="visually-hidden">{{ 'header.directions' | t }}</span>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>

  <nav class="header__nav" aria-label="{{ 'header.nav_label' | t }}">
    <div class="header__links">{{ nav_links }}</div>
    <div class="header__nav-cart">{{ cart_button }}</div>
  </nav>

  {% render 'rule', class: 'header__rule' %}
</header>
{%- comment -%}
  The header's height, set before first paint so a page-top hero (100svh
  minus the header) is the right height straight away instead of jumping
  when assets/header.js loads. header.js keeps it current after that.
{%- endcomment -%}
<script>
  (function () {
    var h = document.currentScript.previousElementSibling;
    if (h && h.matches('[data-header]')) document.documentElement.style.setProperty('--header-height', h.offsetHeight + 'px');
  })();
</script>

{%- comment -%} Desktop: a compact bar that slides in once the header has scrolled away. {%- endcomment -%}
<div class="header-sticky" data-header-sticky aria-hidden="true" inert>
  <div class="header-sticky__row">
    <a class="header__wordmark" href="{{ routes.root_url }}" tabindex="-1">
      <span class="visually-hidden">{{ shop.name }}</span>
      {{ 'logo-wordmark.svg' | inline_asset_content }}
    </a>
    <nav class="header__nav" aria-label="{{ 'header.nav_label' | t }}">
      <div class="header__links">{{ nav_links }}</div>
      {{ cart_button }}
    </nav>
  </div>
  {% render 'rule' %}
</div>

{%- comment -%} Opening hours for assets/header.js. {%- endcomment -%}
<script type="application/json" data-opening-hours>
  {
    "timezone": "Australia/Sydney",
    "nowBaking": {{ section.settings.now_baking | json }},
    "days": [
      {%- assign day_keys = 'sunday,monday,tuesday,wednesday,thursday,friday,saturday' | split: ',' -%}
      {%- for key in day_keys -%}
        {%- liquid
          assign open_key = 'hours_' | append: key | append: '_open'
          assign close_key = 'hours_' | append: key | append: '_close'
          assign closed_key = 'hours_' | append: key | append: '_closed'
        -%}
        { "open": {{ settings[open_key] | strip | json }}, "close": {{ settings[close_key] | strip | json }}, "closed": {{ settings[closed_key] | json }} }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "strings": {
      "open": {{ 'header.status.open' | t | json }},
      "nowBakingOpen": {{ 'header.status.now_baking_open' | t | json }},
      "closedToday": {{ 'header.status.closed_today' | t | json }},
      "closedTomorrow": {{ 'header.status.closed_tomorrow' | t | json }},
      "closedDay": {{ 'header.status.closed_day' | t | json }},
      "closed": {{ 'header.status.closed' | t | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Layout",
      "info": "Automatic uses the masthead on home and compact on other pages.",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "masthead", "label": "Masthead" },
        { "value": "compact", "label": "Compact" }
      ],
      "default": "auto"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Links after \"order\": menu, visit, about.",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "order_url",
      "label": "Order link",
      "info": "Where \"order\" goes if the order panel cannot open. Defaults to all products."
    },
    { "type": "header", "content": "Status and address" },
    {
      "type": "checkbox",
      "id": "now_baking",
      "label": "Now baking",
      "info": "When on, the open status reads \"now baking, open now\". Opening hours are in Theme settings.",
      "default": true
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "info": "Line breaks are kept on the desktop masthead.",
      "default": "336 Brunswick St,\nFitzroy, Melbourne"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Directions link",
      "info": "Google Maps directions to the shop."
    }
  ]
}
{% endschema %}
