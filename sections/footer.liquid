{%- comment -%}
  Site footer: brand mark, links, then one line at Meta size: copyright,
  policy links (each only when that policy exists in Settings > Policies)
  and "credits", which reveals "design and development by Office BFF" on
  hover, focus or tap (Theme settings > Footer credit). Stacked on mobile.
  Sign up and follow us sit above it in the footer group.
{%- endcomment -%}
<footer class="footer">
  <div class="footer__mark" style="--brand-mark-fill: var(--colour-{{ section.settings.mark_colour }});">
    {{ 'logo-brand-mark.svg' | inline_asset_content }}
  </div>

  <div class="footer__links">
    <nav aria-label="{{ 'footer.nav_label' | t }}">
      <ul class="footer__list" role="list">
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title | downcase }}</a></li>
        {%- endfor -%}
        {%- if section.settings.instagram_url != blank -%}
          <li class="footer__item--social"><a href="{{ section.settings.instagram_url }}">{{ 'footer.instagram' | t }}</a></li>
        {%- endif -%}
        {%- if section.settings.tiktok_url != blank -%}
          <li class="footer__item--social"><a href="{{ section.settings.tiktok_url }}">{{ 'footer.tiktok' | t }}</a></li>
        {%- endif -%}
        {%- if section.settings.policies_url != blank -%}
          <li><a href="{{ section.settings.policies_url }}">{{ 'footer.policies' | t }}</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="footer__base type-meta">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | downcase }}</p>
      {%- liquid
        assign policy_handles = 'refund-policy,privacy-policy,terms-of-service,shipping-policy,contact-information' | split: ','
        assign policy_links = ''
        for handle in policy_handles
          assign wanted = '/policies/' | append: handle
          for policy in shop.policies
            if policy.url contains wanted and policy.body != blank
              assign policy_label = policy.title | downcase | escape
              assign one = '<li><a href="' | append: policy.url | append: '">' | append: policy_label | append: '</a></li>'
              assign policy_links = policy_links | append: one
            endif
          endfor
        endfor
      -%}
      {%- if policy_links != blank -%}
        <nav class="footer__policies" aria-label="{{ 'policies.nav_label' | t | escape }}">
          <ul role="list">{{ policy_links }}</ul>
        </nav>
      {%- endif -%}
      {%- if settings.show_credit and settings.credit_link != blank -%}
        <p class="footer__credit" data-credit>
          <button type="button" class="footer__credit-toggle" aria-expanded="false" aria-controls="FooterCredit" data-credit-toggle>{{ 'footer.credits' | t }}</button>
          <a class="footer__credit-link" id="FooterCredit" href="{{ settings.credit_link }}" target="_blank" rel="noopener">{{ 'footer.credit' | t }}</a>
        </p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer block block--image",
  "settings": [
    {
      "type": "select",
      "id": "mark_colour",
      "label": "Brand mark colour",
      "options": [
        { "value": "blue-sky", "label": "Blue sky" },
        { "value": "clementine", "label": "Clementine" },
        { "value": "birthday-pink", "label": "Birthday pink" },
        { "value": "strawberry", "label": "Strawberry" }
      ],
      "default": "blue-sky"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Ordering and pick up, allergens, wholesale, contact.",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Social and policies"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "paragraph",
      "content": "Policy links show at the foot once each policy is filled in under Settings > Policies."
    }
  ]
}
{% endschema %}
