{%- comment -%}
  Order panel. Opened by "order" in the header. A centred panel six columns
  wide under the header on desktop, a full-screen sheet on mobile.
  Each row is a channel; its button says where it goes. A row can link
  somewhere, open help me order, be the delivery row (its link, normally
  /collections/pies?method=delivery; shown only while Theme settings >
  Ordering > Delivery is on) or the pre order row (label from the pre order window's
  name, shown only while a window is set, open soon or open).
{%- endcomment -%}
{%- liquid
  capture preorder_state
    render 'preorder-state'
  endcapture
  assign preorder_state = preorder_state | strip
  capture preorder_name
    render 'preorder-state', output: 'name'
  endcapture
  assign preorder_name = preorder_name | strip | downcase
-%}
<dialog
  class="order-panel"
  id="OrderPanel"
  aria-labelledby="OrderPanelHeading"
  data-order-panel
  scroll-lock
>
  <h2 class="visually-hidden" id="OrderPanelHeading">{{ 'order_panel.heading' | t }}</h2>
  <div class="order-panel__top">
    {%- assign close_label = 'general.close' | t -%}
    {% render 'button', label: close_label, style: 'outline', attributes: 'data-dialog-close' %}
  </div>

  <ul class="order-panel__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign is_preorder_row = false
        if block.settings.action == 'preorder' or block.settings.show_when == 'preorder'
          assign is_preorder_row = true
        endif
        if is_preorder_row and preorder_state != 'open' and preorder_state != 'soon'
          continue
        endif
        if block.settings.action == 'delivery' and settings.delivery_enabled == false
          continue
        endif
      -%}
      <li class="order-panel__option" {{ block.shopify_attributes }}>
        <h3 class="order-panel__title type-d4">{{ block.settings.title | escape }}</h3>
        {%- if block.settings.action == 'help_me_order' -%}
          {% render 'button', label: block.settings.button_label, attributes: 'data-help-me-order-open' %}
        {%- elsif block.settings.action == 'delivery' -%}
          {% render 'button', label: block.settings.button_label, url: block.settings.link, attributes: 'data-method-link="delivery"' %}
        {%- elsif block.settings.action == 'preorder' -%}
          {%- assign preorder_label = preorder_name | default: block.settings.button_label -%}
          {% render 'button', label: preorder_label, url: block.settings.link %}
        {%- else -%}
          {%- liquid
            assign link_attr = ''
            if block.settings.link contains '/collections/'
              assign link_attr = 'data-method-link="pickup"'
            endif
          -%}
          {% render 'button', label: block.settings.button_label, url: block.settings.link, attributes: link_attr %}
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</dialog>

{% schema %}
{
  "name": "Order panel",
  "class": "section-order-panel",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "option",
      "name": "Option",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pick up" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "order with us" },
        {
          "type": "select",
          "id": "action",
          "label": "Button",
          "options": [
            { "value": "link", "label": "Goes to a link" },
            { "value": "help_me_order", "label": "Opens help me order" },
            { "value": "delivery", "label": "Delivery (shown while delivery is on)" },
            { "value": "preorder", "label": "Pre order (label from the window name)" }
          ],
          "default": "link"
        },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "show_when",
          "label": "Show",
          "options": [
            { "value": "always", "label": "Always" },
            { "value": "preorder", "label": "Only while pre orders are set" }
          ],
          "default": "always"
        }
      ]
    }
  ]
}
{% endschema %}
