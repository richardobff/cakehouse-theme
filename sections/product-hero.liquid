{%- comment -%}
  Product hero (an image block): the product's main photo, edge to edge,
  3:2 on desktop and 4:5 on mobile. A brand colour block until there is a photo.
{%- endcomment -%}
{%- assign hero_alt = product.featured_media.alt | default: product.title -%}
<section class="product-hero" aria-label="{{ product.title | escape }}">
  {% render 'media',
    image: product.featured_media.preview_image,
    ratio: section.settings.ratio,
    ratio_mobile: section.settings.ratio_mobile,
    colour: section.settings.colour,
    alt: hero_alt,
    priority: true
  %}
</section>

{% schema %}
{
  "name": "Product hero",
  "class": "section-product-hero block block--image",
  "settings": [
    {
      "type": "select",
      "id": "ratio",
      "label": "Shape on desktop",
      "options": [
        { "value": "3 / 2", "label": "Landscape (1440 x 960)" },
        { "value": "16 / 9", "label": "Widescreen" }
      ],
      "default": "3 / 2"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Shape on mobile",
      "options": [
        { "value": "4 / 5", "label": "Portrait (390 x 488)" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "colour",
      "label": "Colour while loading",
      "options": [
        { "value": "clementine", "label": "Clementine" },
        { "value": "birthday-pink", "label": "Birthday pink" },
        { "value": "blue-sky", "label": "Blue sky" },
        { "value": "strawberry", "label": "Strawberry" }
      ],
      "default": "clementine"
    }
  ]
}
{% endschema %}
