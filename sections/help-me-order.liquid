{%- comment -%}
  Help me order entry. Layout lives in snippets/split.liquid.
{%- endcomment -%}
{% render 'split', section: section, button_size: 'large' %}

{% schema %}
{
  "name": "Help me order entry",
  "class": "section-help-me-order block block--colour",
  "settings": [
    {
      "type": "select",
      "id": "colour",
      "label": "Colour",
      "options": [
        { "value": "clementine", "label": "Clementine" },
        { "value": "birthday-pink", "label": "Birthday pink" },
        { "value": "blue-sky", "label": "Blue sky" },
        { "value": "strawberry", "label": "Strawberry" }
      ],
      "default": "clementine"
    },
    { "type": "text", "id": "title", "label": "Title", "default": "Help me order" },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Pick a pie, a size and a day. We will do the rest.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "start an order" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side on desktop",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "1 / 1", "label": "Square (720 x 720)" },
        { "value": "4 / 5", "label": "Portrait (720 x 900)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "text",
      "id": "preview_image",
      "label": "Temporary preview image",
      "info": "Theme asset from Figma, shown until an image is chosen. Clear before launch."
    }
  ],
  "presets": [{ "name": "Help me order entry" }]
}
{% endschema %}
