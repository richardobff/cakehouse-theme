{%- comment -%}
  Product grid (a white block): title, copy and an optional prompt with a
  button on the top line, then the products from a chosen collection,
  4 across on desktop, 2 on mobile.
  The button goes to the product page, where format and pick up date are
  chosen. With no collection or no products it shows a short empty state.
{%- endcomment -%}
{%- liquid
  assign grid_collection = section.settings.collection
  assign current_product_id = product.id
  assign shown = 0
  assign colours = 'birthday-pink,clementine,blue-sky,strawberry' | split: ','
-%}
<section class="product-grid page-width">
  {% render 'block-head',
    title: section.settings.title,
    copy: section.settings.copy,
    prompt: section.settings.prompt,
    button_label: section.settings.cta_label,
    button_link: section.settings.cta_link,
    button_style: 'outline',
    button_mobile: section.settings.cta_mobile
  %}
  {%- if grid_collection != blank and grid_collection.products_count > 0 -%}
    <ul class="product-grid__list" role="list">
      {%- for product in grid_collection.products -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- if settings.pickup_product != blank and product.id == settings.pickup_product.id -%}{%- continue -%}{%- endif -%}
        {%- comment -%} On a product page, leave out the pie being viewed ("more pies"). {%- endcomment -%}
        {%- if current_product_id and product.id == current_product_id -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign colour_index = forloop.index0 | modulo: 4 -%}
        <li class="card">
          <a class="card__link" href="{{ product.url }}">
            {% render 'media',
              image: product.featured_image,
              ratio: '4 / 5',
              sizes: '(min-width: 750px) 25vw, 50vw',
              colour: colours[colour_index],
              alt: product.title,
              class: 'card__media'
            %}
            <span class="card__name">{{ product.title | escape }}</span>
          </a>
          <p class="card__price type-product">
            {%- if product.price_varies -%}
              {{ 'products.from_price' | t: price: product.price_min | money }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </p>
          {%- if product.available -%}
            {% render 'button', label: section.settings.button_label, url: product.url, style: 'outline' %}
          {%- else -%}
            {%- assign sold_out = 'products.sold_out' | t -%}
            {% render 'button', label: sold_out, style: 'outline', attributes: 'disabled' %}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <div class="product-grid__empty">
      <p class="product-grid__empty-text">{{ section.settings.empty_text | escape }}</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product grid",
  "class": "section-product-grid block block--white",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Order pies" },
    { "type": "richtext", "id": "copy", "label": "Copy" },
    { "type": "text", "id": "prompt", "label": "Lead-in line", "info": "Optional, e.g. Not sure what to get?" },
    { "type": "text", "id": "cta_label", "label": "Lead-in button label" },
    { "type": "url", "id": "cta_link", "label": "Lead-in button link" },
    { "type": "checkbox", "id": "cta_mobile", "label": "Show lead-in on mobile", "default": false },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "add to cart" },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when there are no products",
      "default": "Pies are on their way."
    }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
