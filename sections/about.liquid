{%- comment -%}
  About: portrait on the left half, copy and button at the foot of the right half.
  On mobile the portrait runs edge to edge with the copy below.
{%- endcomment -%}
<section class="about">
  {% render 'media',
    image: section.settings.portrait,
    preview: section.settings.preview_image,
    ratio: '4 / 5',
    sizes: '(min-width: 750px) 50vw, 100vw',
    colour: 'clementine',
    class: 'about__portrait'
  %}
  <div class="about__copy">
    {%- if section.settings.copy != blank -%}
      <div class="about__text type-body">{{ section.settings.copy }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      {% render 'button', label: section.settings.button_label, url: section.settings.button_link, style: 'outline' %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About",
  "class": "section-about",
  "settings": [
    { "type": "image_picker", "id": "portrait", "label": "Portrait" },
    { "type": "richtext", "id": "copy", "label": "Copy" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "about" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "text",
      "id": "preview_image",
      "label": "Temporary preview image",
      "info": "Theme asset from Figma, shown until a portrait is chosen. Clear before launch."
    }
  ],
  "presets": [{ "name": "About" }]
}
{% endschema %}
