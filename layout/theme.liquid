<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      // Last input type, so the focus ring only shows for keyboard use.
      addEventListener('pointerdown', () => document.documentElement.setAttribute('data-input', 'pointer'), { capture: true, passive: true });
      addEventListener('keydown', (e) => { if (!e.metaKey && !e.ctrlKey && !e.altKey) document.documentElement.setAttribute('data-input', 'keyboard'); }, true);
    </script>

    {% # Brand fonts: self-hosted, preloaded, font-display: swap %}
    {{ 'Futura-CondensedExtraBold.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'Futura-Medium.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {% render 'font-faces' %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
    {{ 'order.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'header.js' | asset_url }}" defer></script>
    <script src="{{ 'order.js' | asset_url }}" defer></script>
    <script src="{{ 'follow-us.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'motion.js' | asset_url }}" defer></script>
    {%- comment -%} Prefetch same-site pages on hover (Chromium). motion.js covers other browsers. {%- endcomment -%}
    <script type="speculationrules">
      {
        "prefetch": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": ["/cart", "/cart/*", "/checkout", "/checkouts/*", "/account", "/account/*"] } },
                { "not": { "selector_matches": "[data-order-trigger], [data-cart-trigger], [target=_blank]" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    {%- if template.name == 'product' %}
    <script src="{{ 'product.js' | asset_url }}" defer></script>
    {%- endif %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {%- if request.page_type == 'policy' -%}
        {%- comment -%} Policy pages: title on the top line, the policy list left, the text right. {%- endcomment -%}
        <div class="shopify-section block block--white">
          <div class="policy page-width">
            <nav class="policy__nav" aria-label="{{ 'policies.nav_label' | t | escape }}">
              <ul role="list">
                {%- for policy in shop.policies -%}
                  <li><a href="{{ policy.url }}"{% if policy.url == request.path %} aria-current="page"{% endif %}>{{ policy.title | downcase | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
            {{ content_for_layout }}
          </div>
        </div>
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}
    {%- unless template.name == 'cart' -%}{% section 'cart-drawer' %}{%- endunless -%}
  </body>
</html>
