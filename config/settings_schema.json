  {
    "name": "Ordering",
    "settings": [
      {
        "type": "paragraph",
        "content": "Rules for the pick up date picker. Values marked (to confirm) are placeholders until Suzie confirms them. Dates use Australia/Sydney time."
      },
      {
        "type": "text",
        "id": "pickup_address",
        "label": "Pick up address",
        "default": "336 Brunswick St, Fitzroy"
      },
      {
        "type": "range",
        "id": "lead_time_days",
        "label": "Lead time for whole pies",
        "info": "Business days between ordering and pick up.",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "d",
        "default": 2
      },
      {
        "type": "range",
        "id": "slice_lead_days",
        "label": "Lead time for slices (to confirm)",
        "info": "0 means same day, from the counter's stock.",
        "min": 0,
        "max": 5,
        "step": 1,
        "unit": "d",
        "default": 0
      },
      {
        "type": "text",
        "id": "cutoff_time",
        "label": "Daily cut-off",
        "info": "24-hour time, Australia/Sydney. Orders before the cut-off count the lead time from that day; after it, from the next day. Leave empty for no cut-off.",
        "default": "12:00"
      },
      {
        "type": "range",
        "id": "booking_horizon_days",
        "label": "How far ahead people can order",
        "min": 14,
        "max": 126,
        "step": 7,
        "unit": "d",
        "default": 63
      },
      {
        "type": "header",
        "content": "Closed days (to confirm)"
      },
      {
        "type": "checkbox",
        "id": "closed_monday",
        "label": "Monday",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "closed_tuesday",
        "label": "Tuesday",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "closed_wednesday",
        "label": "Wednesday",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "closed_thursday",
        "label": "Thursday",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "closed_friday",
        "label": "Friday",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "closed_saturday",
        "label": "Saturday",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "closed_sunday",
        "label": "Sunday",
        "default": false
      },
      {
        "type": "textarea",
        "id": "blackout_dates",
        "label": "Blackout dates",
        "info": "One date per line, as YYYY-MM-DD."
      },
      {
        "type": "header",
        "content": "Pre order"
      },
      {
        "type": "textarea",
        "id": "preorder_windows",
        "label": "Pre order windows",
        "info": "One window per line, with an optional name before a colon: christmas: order from 2026-12-01 to 2026-12-20, pick up 2026-12-23 2026-12-24. Ordering opens and closes on the first two dates; the pick up dates follow. The name is the order panel button."
      },
      {
        "type": "collection",
        "id": "preorder_collection",
        "label": "Pre order collection",
        "info": "Pies in this collection say \"pre order\" and can only be picked up on the window's dates. Defaults to the collection with the handle pre-order."
      },
      {
        "type": "header",
        "content": "Delivery"
      },
      {
        "type": "paragraph",
        "content": "Delivery goes through a third-party service, linked from the order panel. The Delivery row shows once the link is set."
      },
      {
        "type": "text",
        "id": "delivery_label",
        "label": "Delivery button label",
        "default": "uber eats"
      },
      {
        "type": "url",
        "id": "delivery_link",
        "label": "Delivery link"
      },
      {
        "type": "header",
        "content": "Daily caps"
      },
      {
        "type": "checkbox",
        "id": "use_daily_caps",
        "label": "Use daily caps",
        "info": "When on, each order adds the hidden pick up line for its date and sold-out days show as full. Off for now.",
        "default": false
      },
      {
        "type": "product",
        "id": "pickup_product",
        "label": "Pick up dates product",
        "info": "Hidden product with one variant per pick up date (option value YYYY-MM-DD). Each variant's stock is that day's cap."
      }
    ]
  }
